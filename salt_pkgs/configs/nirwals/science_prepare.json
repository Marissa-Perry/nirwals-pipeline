{
    "NOTES": [
        "a. Re smoothing parameters: window_length must be > polyorder + 1 for smooting to be applied.",
        "b. The trace[fit] entry in nirwals/science_reduce.json must be the same as the trace[fit] entry in nirwals/science_prepare.json!"
    ],

    "output": {"dir": "", "plot_fibre_profiles": 1, "plot_fibre_traces": 1},

    "fibre_traces_db": "nirwals/fibre_traces.json",
    "fibre_traces_wrk": "fibre_traces.json",

    "nr_of_blocks": 8,
    "nr_of_fibres": 248,

    "profile": {
        "compress": "median",
        "smooth": {"window_length": 3, "polyorder": 1}
    },

    "trace": {
        "fit": {"function": "polynomial", "order": 2, "niter": 5},
        "window": {"size": 256, "step": 128},
        "clip": {"sigma": 3.0, "cenfunc": "mean"},
        "point_tolerance": 1.5,
        "min_points_pc": 50.0
    },

    "bpm": {
        "allow_existing": true,
        "notes": [
            "a. the pipeline always checks this night's own work directory (NIRWALS_work/bpm/) for a pre-generated BPM file; allow_existing controls whether it's used;",
            "b. pixels >= threshold.sigma are masked;",
            "c. crosstalk.correct_neighbors: deconvolves IPC per pixel, where the neighboring pixel read first gets alpha_asym_1, the other 3 share alpha_asym_3",
            "d. crosstalk.correct_neighbors.per_pixel_alpha: uses each isolated hot pixel's own measured alpha where available, else that night's median, else the default values defined;",
            "e. crosstalk.isolation_radius: pixel distance defining an isolated hot pixel for alpha measurement"
        ],
        "threshold": {
            "sigma": 5.0,
            "flat_smooth_k": 15,
            "flat_illum_frac": 0.2
        },
        "crosstalk": {
            "isolation_radius": 5,
            "correct_neighbors": {
                "apply": true,
                "alpha_asym_3": 0.01,
                "alpha_asym_1": 0.01,
                "per_pixel_alpha": {
                    "apply": true,
                    "min_measured": 100
                }
            }
        }
    },

    "flat": {
        "reference": "",
        "continuum": {
            "fit": {"function": "legendre", "order": 21, "low_reject": 2, "high_reject": 2, "niter": 10},
            "cols": [4, 2045]
        },
        "find_peaks": {"width": 5, "wlen": 10, "rel_height": 0.9}
    },

    "config_key": {
        "list": ["PIXSUM", "GRATING", "CAMANG", "GRTILT"],
        "frmts": [
            {"key": "PIXSUM", "type": "replace", "frmt": [" ", "x"]},
            {"key": "GRATING", "type": "", "frmt": ""},
            {"key": "CAMANG", "type": "format", "frmt": "CA{0}"},
            {"key": "GRTILT", "type": "format", "frmt": "GA{0}"}
        ]
    },

    "fibres": {
